# =====================================================================
# Orion - API Intelligence Layer (.env.example)
# Copy this file to .env or .env.local and populate with your credentials.
# DO NOT commit production API keys or credentials to version control.
# =====================================================================

# ---------------------------------------------------------------------
# Firebase Authentication & Database Configuration (Client-Safe)
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-app-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ---------------------------------------------------------------------
# AI Provider Selection ('groq' or 'organizer')
# ---------------------------------------------------------------------
AI_PROVIDER=groq

# ---------------------------------------------------------------------
# Groq AI Provider Configuration (Server-Side Only)
# ---------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------
# Organizer Cloud AI Provider Configuration (Server-Side Only)
# ---------------------------------------------------------------------
# Base URL for the Organizer's AI endpoint (e.g. https://api.organizer.ai/v1)
ORGANIZER_AI_BASE_URL=https://api.organizer.com/v1

# Secret API Key provided by the competition organizer
ORGANIZER_AI_API_KEY=your_organizer_api_key_here

# Required Authentication Header Name (e.g. 'Authorization', 'x-api-key', 'api-key')
# If 'Authorization' is specified, 'Bearer <key>' will automatically be formatted if needed.
ORGANIZER_AI_AUTH_HEADER=Authorization

# Target AI Model identifier provided by organizer
ORGANIZER_AI_MODEL=organizer-model-name
